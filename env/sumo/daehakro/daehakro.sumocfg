<configuration>
    <input>
        <net-file value="daehakro.net.xml"/>
        <route-files value="daehakro.rou.xml"/>
        <additional-files value="daehakro.tll.xml,daehakro.stops.xml,daehakro.deco.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.5"/>
    </time>
    <processing>
        <!-- 순간이동 끔 (2026-11-21 팀 결정): 오래 막힌 차를 SUMO 가 옮기지 않는다. 바꾸지 말 것 -->
        <time-to-teleport value="-1"/>
        <!-- 충돌 처리: 학습·평가 때는 수업 코드(env/sumo_env.py)가 실행 옵션으로 remove 를 준다. 이 값은 sumo-gui 로 도로만 볼 때 쓰인다 -->
        <collision.action value="warn"/>
        <collision.check-junctions value="true"/>
        <ignore-route-errors value="true"/>
        <pedestrian.model value="striping"/>
    </processing>
    <random_number>
        <seed value="42"/>
    </random_number>
    <gui_only>
        <gui-settings-file value="daehakro.gui.xml"/>
    </gui_only>
</configuration>
